{
  "name": "bangguseok-camp",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": ".build/site",
    "binding": "ASSETS",
    "run_worker_first": ["/chat", "/health", "/stats"]
  },
  "durable_objects": {"bindings": [{"name": "CAMPS", "class_name": "CampRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CampRoom"]}]
}
